# PicoShare on Railway — environment variables
#
# Copy to .env only for local testing; on Railway these are service variables.

# Admin passphrase for logging in to PicoShare. Required at boot — the
# server refuses to start without it (or PS_SHARED_SECRET_FILE).
# On Railway this is a generated secret; pick your own value here.
PS_SHARED_SECRET=your-admin-passphrase-here

# Port PicoShare listens on. Railway injects PORT automatically; the default
# of 4001 only applies when PORT is unset (e.g. local runs).
PORT=4001

# Set to "true" when running behind a reverse proxy (Railway's edge) so
# PicoShare trusts X-Forwarded-Proto / X-Forwarded-For. Baked into the image.
PS_BEHIND_PROXY=true
